# This code has been fully generated by an AI.
#
# Image for the my Velo Home Assistant add-on.
# Build context is the repository root:
#   docker build -t my-velo .
#   docker buildx build --platform linux/arm64 --build-arg VERSION=0.1.0 .
#
# The Go binary is cross-compiled on the build platform (pure Go, no CGO);
# the final stage only copies it. aarch64 images therefore build on x86
# without QEMU. Do not add RUN instructions to the final stage.

ARG GO_VERSION=1.26
ARG ALPINE_VERSION=3.24

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS go-build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/myvelo ./cmd/myvelo

# Alpine provides the CA certificates for HTTPS to Garmin and Home
# Assistant; time zone data is embedded in the binary.
FROM alpine:${ALPINE_VERSION}
ARG VERSION=dev
LABEL io.hass.type="addon" \
      io.hass.version="${VERSION}" \
      org.opencontainers.image.title="my Velo" \
      org.opencontainers.image.source="https://github.com/stefanluchs/my-velo" \
      org.opencontainers.image.version="${VERSION}"

COPY --from=go-build /out/myvelo /usr/local/bin/myvelo

EXPOSE 8099
ENTRYPOINT ["/usr/local/bin/myvelo"]
